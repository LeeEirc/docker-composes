#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${HOME}/.vnc"
mkdir -p /run/dbus

if [[ ! -S /run/dbus/system_bus_socket ]]; then
  dbus-daemon --system --fork
fi

if [[ -n "${VNC_PASSWORD:-}" ]]; then
  vncpasswd_cmd="$(command -v vncpasswd || command -v tigervncpasswd || true)"
  if [[ -z "${vncpasswd_cmd}" ]]; then
    echo "vncpasswd command not found. Install tigervnc-tools in the image." >&2
    exit 1
  fi
  printf '%s\n' "${VNC_PASSWORD}" | "${vncpasswd_cmd}" -f > "${HOME}/.vnc/passwd"
  chmod 600 "${HOME}/.vnc/passwd"
fi

cat > "${HOME}/.vnc/xstartup" <<'XSTARTUP'
#!/usr/bin/env bash
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export NO_AT_BRIDGE=1
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-${USER:-root}}"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"
xset s off >/dev/null 2>&1 || true
xset s noblank >/dev/null 2>&1 || true
xset -dpms >/dev/null 2>&1 || true
exec dbus-run-session -- startxfce4
XSTARTUP
chmod +x "${HOME}/.vnc/xstartup"

vncserver -kill "${VNC_DISPLAY}" >/dev/null 2>&1 || true
vncserver "${VNC_DISPLAY}" \
  -geometry "${VNC_GEOMETRY}" \
  -depth "${VNC_DEPTH}" \
  -localhost no

DISPLAY="${VNC_DISPLAY}" xset s off >/dev/null 2>&1 || true
DISPLAY="${VNC_DISPLAY}" xset s noblank >/dev/null 2>&1 || true
DISPLAY="${VNC_DISPLAY}" xset -dpms >/dev/null 2>&1 || true

if command -v websockify >/dev/null 2>&1 && [[ -d /usr/share/novnc ]]; then
  websockify --web=/usr/share/novnc "${NOVNC_PORT}" "localhost:${VNC_PORT}" &
fi

tail -F "${HOME}/.vnc/"*.log
